# Kopieren nach ".env" und Werte ersetzen. Die echte .env NIE ins Repo hochladen.

# Immich-Version (fest gepinnt, nicht "release" verwenden, siehe README)
IMMICH_VERSION=v3.2.0

# Datenbank-Passwort. Nur Buchstaben und Ziffern verwenden.
# Wird nur beim ersten Start der Datenbank übernommen.
DB_PASSWORD=HIER_EIN_LANGES_ZUFAELLIGES_PASSWORT

# Cloudflare-Tunnel-Token (Zero Trust Dashboard -> Tunnel)
TUNNEL_TOKEN=HIER_DEN_TOKEN_EINFUEGEN
